# Store real values only in the server's private environment file.
OURPETS_BIND=0.0.0.0:9377
OURPETS_DATA=/var/lib/our-pets
OURPETS_INVITE=replace-with-private-lan-invite
OURPETS_ALLOWED_CIDRS=127.0.0.0/8,::1/128,192.168.10.0/24
OURPETS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
OURPETS_MESSAGE_TTL=1m
OURPETS_RETENTION=1h
OURPETS_SAMPLE_ENABLED=false
# For TLS, set both values and configure clients to trust the LAN CA.
# OURPETS_TLS_CERT=/etc/our-pets/server.crt
# OURPETS_TLS_KEY=/etc/our-pets/server.key
