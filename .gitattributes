# 텍스트 줄 끝을 통일하고 에셋은 바이너리 그대로 보존한다.
* text=auto eol=lf
*.png binary
*.gif binary
*.ico binary
*.icns binary
*.woff2 binary

# 외부 라이선스·출처 원문에 포함된 공백은 그대로 보존한다.
desktop/public/fonts/OFL.txt -whitespace
desktop/public/licenses/* -whitespace
desktop/src/assets/builtin/gopher/README.source.md -whitespace

# 출처 지문과 외부 라이선스 원문의 줄 끝을 바꾸지 않는다.
desktop/src/assets/builtin/gopher/source.json -text -whitespace
desktop/public/licenses/gopher-CC0.txt -text

# 보안 패치 출처 검증에 사용하는 외부 원본의 바이트와 공백을 보존한다.
desktop/src-tauri/vendor/glib-0.18.5/** -text -whitespace

# 생성 고지와 외부 소스 사본은 지문 검증을 위해 원본 바이트를 유지한다.
desktop/public/licenses/dependencies.txt -text -whitespace linguist-generated=true
desktop/public/licenses/sources/** binary
scripts/license-overrides/** -text -whitespace linguist-vendored=true
